{
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{bin/**,node_modules/@ffmpeg-installer/linux-x64/ffmpeg,node_modules/@ffprobe-installer/linux-x64/ffprobe}",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}