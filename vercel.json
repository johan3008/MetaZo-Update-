{
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{bin/**,node_modules/@ffmpeg-installer/linux-x64/**,node_modules/@ffmpeg-installer/ffmpeg/**,node_modules/@ffprobe-installer/linux-x64/**,node_modules/@ffprobe-installer/ffprobe/**,node_modules/fluent-ffmpeg/**}",
      "excludeFiles": "{node_modules/@ffmpeg-installer/win32-x64/**,node_modules/@ffprobe-installer/win32-x64/**,node_modules/@ffmpeg-installer/darwin*/**,node_modules/@ffprobe-installer/darwin*/**,node_modules/onnxruntime-web/**,node_modules/@imgly/**}",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index.js"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index.js"
    },
    {
      "source": "/landing",
      "destination": "/index.html"
    },
    {
      "source": "/landing.html",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app.html"
    },
    {
      "source": "/",
      "destination": "/app.html"
    },
    {
      "source": "/((?!api|assets|src|favicon|.*\\..*).*)",
      "destination": "/app.html"
    }
  ]
}