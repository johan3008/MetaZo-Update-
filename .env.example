GEMINI_API_KEY=
EMAIL_USER=
EMAIL_PASS=

# Cloudflare R2 / S3 Config (Optional - For uploading large Vector EPS files up to 500MB)
# For Cloudflare R2, Endpoint looks like: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# S3_PUBLIC_URL is optional. For Cloudflare R2, use your connected custom domain (e.g. https://pub-xxx.r2.dev)
S3_PUBLIC_URL=

# Vercel Blob Token
BLOB_READ_WRITE_TOKEN=
