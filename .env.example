GEMINI_API_KEY=
EMAIL_USER=
EMAIL_PASS=

# =============================================
# Cloudflare D1 & R2 — REQUIRED untuk upload EPS/AI besar dan Backup/Restore
# Tanpa R2, Vercel akan menolak file > 4.5MB (body limit)
# =============================================
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Public URL bucket (custom domain atau R2 dev URL: https://pub-xxx.r2.dev)
S3_PUBLIC_URL=

# Cloudflare D1 Database Credentials
# Account ID will automatically extract from S3_ENDPOINT if left blank
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_DATABASE_ID=

# Vercel Blob Token (opsional, fallback jika R2 tidak dikonfigurasi)
BLOB_READ_WRITE_TOKEN=

# Bluesminds API
BLUESMINDS_API_KEY=
BLUESMINDS_API_ENDPOINT=
VITE_PAKASIR_PROJECT_SLUG=
VITE_PAKASIR_API_KEY=
