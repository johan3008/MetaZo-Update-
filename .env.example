GEMINI_API_KEY=
EMAIL_USER=
EMAIL_PASS=

# =============================================
# Cloudflare R2 — REQUIRED untuk upload EPS/AI besar di Vercel
# Tanpa ini, Vercel akan menolak file > 4.5MB (body limit)
# =============================================
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Public URL bucket (custom domain atau R2 dev URL: https://pub-xxx.r2.dev)
S3_PUBLIC_URL=

# Vercel Blob Token (opsional, fallback jika R2 tidak dikonfigurasi)
BLOB_READ_WRITE_TOKEN=

# Bluesminds API
BLUESMINDS_API_KEY=
BLUESMINDS_API_ENDPOINT=VITE_PAKASIR_PROJECT_SLUG=
VITE_PAKASIR_API_KEY=
